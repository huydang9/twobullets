# twobullets production settings. Copy to /opt/twobullets/.env on the server, fill in, `chmod 600 .env`.
# Never commit the real .env. Generate random secrets with: openssl rand -hex 24

# ─── Site ───────────────────────────────────────────────────────────────────────────────────────────────────────────
# Public hostname; the host's nginx terminates TLS and proxies to 127.0.0.1:TB_HTTP_PORT (see nginx/twobullets.conf).
TB_DOMAIN=twobullets.huydang.me
TB_HTTP_PORT=8080

# ─── Access ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# Friends type this once at guest login. Empty = anyone with the URL can play.
TB_INVITE_CODE=
# Bearer token for GET /metrics (only reachable inside the server anyway).
TB_METRICS_TOKEN=
# Extra browser origins allowed to call the API (comma-separated), e.g. a Cloudflare Pages URL. Empty = same origin.
TB_CORS_ORIGINS=

# ─── Identity of this host ───────────────────────────────────────────────────────────────────────────────────────────
TB_REGION=sg
TB_HOST_ID=sg-1

# ─── Matches on this host ────────────────────────────────────────────────────────────────────────────────────────────
# process = fork a server-match per match (needs server-match --mode=agent); fake = no game servers (UI testing).
TB_ALLOCATOR=process
# Concurrent matches. Plan ~0.3 vCPU and ~250 MB per 20-player match (bots included); 4 vCPU / 8 GB → 4–6.
TB_MAX_MATCHES=2
# Must stay inside 7400–7499 (the Caddyfile route) and inside the `expose` range in docker-compose.yml (7400–7409).
TB_MATCH_PORT_MIN=7400
TB_MATCH_PORT_MAX=7409
# Kill a match process after this many minutes no matter what (normal matches end in ~12).
TB_MATCH_MAX_MINUTES=25
TB_MATCH_READY_TIMEOUT_MS=30000
# Memory cap for the server container (API + all match processes).
TB_SERVER_MEMORY_LIMIT=2g

# ─── Queue and lobbies ───────────────────────────────────────────────────────────────────────────────────────────────
# Quick queue starts with bots after the oldest ticket waited this long.
TB_QUEUE_START_AFTER_SEC=30
TB_QUEUE_MIN_HUMANS=1
TB_LOBBY_IDLE_MINUTES=30

# ─── Abuse limits ────────────────────────────────────────────────────────────────────────────────────────────────────
# Guest logins/refreshes per IP per minute, and API calls per account per minute.
TB_RATE_AUTH_PER_MIN=10
TB_RATE_API_PER_MIN=120

# ─── Files (inside the container; the tb_data volume) ────────────────────────────────────────────────────────────────
# TB_DATA_DIR=/data                        SQLite at /data/twobullets.sqlite
# TB_JWT_KEYS_FILE=/data/keys/jwt-keys.json  created by infra/scripts/keys.sh generate
