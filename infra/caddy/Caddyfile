# App container behind the host's reverse proxy (nginx does TLS). Plain HTTP on :8080 inside the container:
#   /                              client (apps/client/dist)
#   /v1/*, /.well-known/jwks.json  server-api (REST + /v1/ws push)
#   /gs/<port>/m/<matchId>         a match WebSocket on <port> (7400–7499) inside the `server` container

{
	admin off
	auto_https off
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

:8080 {
	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Match WebSockets. The join token travels inside the first message (Hello), never in this URL.
	@game path_regexp game ^/gs/(74[0-9]{2})(/m/[A-Za-z0-9_.:-]{1,64})$
	handle @game {
		rewrite * {re.game.2}
		reverse_proxy server:{re.game.1} {
			flush_interval -1
		}
	}

	# Metrics and anything internal stay off the public internet.
	@private path /metrics /internal/*
	handle @private {
		respond 404
	}

	@api path /v1/* /.well-known/jwks.json /healthz /readyz
	handle @api {
		reverse_proxy server:8080
	}

	handle {
		root * /srv/client
		encode zstd gzip
		@html path / *.html
		header @html Cache-Control "no-cache"
		# Vite's hashed bundles are immutable; public/assets (GLB, textures, audio) keep their names, so cache for an hour.
		@hashed path_regexp hashed ^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css|wasm)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /assets/* ?Cache-Control "public, max-age=3600"
		file_server
	}
}
