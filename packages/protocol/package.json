{
  "name": "@twobullets/protocol",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "decode": "node --import ../../tools/map/lib/resolve.ts src/cli/decode.ts",
    "content-hash": "node --experimental-transform-types scripts/content-hash.ts"
  },
  "dependencies": {
    "@twobullets/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  }
}
